 function adicionarSaldo(guildId, valor, detalhes = {}) {
   const db    = _load();
   const cart  = _getGuild(db, guildId);
   const agora = new Date().toISOString();
 
+  // KRON PRO — OpenPix (Parte 2, TAREFA 8): idempotência do crédito. Se já
