#  KAEL — modelo de configuração.
#  Copie para ".env" (cp .env.example .env), preencha e NUNCA envie o ".env" pro GitHub.
#  Na Railway continue usando as "Variables" (elas têm prioridade sobre este arquivo).
# ═══════════════════════════════════════════════════════════════════

# --- Obrigatórias ---
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
OWNER_ID="1521881835171221559"

# --- Servidor web (webhooks de pagamento e verificação) ---
PORT="3000"
PUBLIC_BASE_URL=""          # endereço público do bot, ex.: https://meu-bot.exemplo.com
SITE_URL=""
TERMOS_URL=""

# --- Pagamentos ---
OPENPIX_APP_ID=""
OPENPIX_BASE_URL="https://api.openpix.com.br"
OPENPIX_WEBHOOK_SECRET=""
C6BANK_HOST_PRODUCAO="api.c6bank.com.br"
C6BANK_HOST_SANDBOX="api-sandbox.c6bank.com.br"

# --- Canais (IDs) ---
LOGS_CANAL_ID=""
BACKUP_CANAL_ID=""          # canal onde o bot guarda a cópia do banco (ele precisa ver e escrever lá)
BACKUP_ALERTA_CANAL_ID=""
